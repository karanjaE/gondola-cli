{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(poetry install)",
      "Bash(poetry run pytest*)",
      "Bash(poetry run mypy*)",
      "Bash(poetry run gondola*)",
      "Bash(poetry build)",
      "Bash(pytest*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git branch*)",
      "Read(/**)",
      "Edit(./api/**)",
      "Edit(./core/**)",
      "Edit(./db/**)",
      "Edit(./test/**)"
    ],
    "ask": [
      "Bash(poetry publish*)",
      "Bash(twine upload*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(gondola db destroy*)",
      "Bash(gondola db clear*)",
      "Bash(gondola migrate down*)",
      "Bash(alembic downgrade*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*token*)",
      "Read(**/*.pypirc)"
    ]
  }
}
