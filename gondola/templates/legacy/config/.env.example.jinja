# Application
APP_NAME={{ project_name }}
DEBUG=False

# Database
{% if db_engine == "postgresql" %}
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/{{ project_name }}
{% elif db_engine == "mysql" %}
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/{{ project_name }}
{% else %}
DATABASE_URL=sqlite+aiosqlite:///./{{ project_name }}.db
{% endif %}

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BACKEND_URL=redis://localhost:6379/2

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@{{ project_name }}.com
SMTP_FROM_NAME={{ project_name }}
