import pytest
from sqlalchemy.ext.asyncio import AsyncSession
from app.models.{{ file_name }} import {{ model_name }}


@pytest.mark.asyncio
async def test_create_{{ file_name }}(session: AsyncSession):
    """Test creating a {{ model_name }}."""
    {{ file_name }} = {{ model_name }}(
        {% for field_name, field_type in fields %}
        {{ field_name }}={% if field_type == "str" %}"test_value"{% elif field_type == "int" %}1{% elif field_type == "float" %}1.0{% elif field_type == "bool" %}True{% else %}None{% endif %},
        {% endfor %}
    )
    
    session.add({{ file_name }})
    await session.commit()
    await session.refresh({{ file_name }})
    
    assert {{ file_name }}.id is not None
    assert {{ file_name }}.created_at is not None
    assert {{ file_name }}.updated_at is not None
